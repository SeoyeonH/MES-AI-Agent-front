            case 3:\n              res = _context3.v;\n              _context3.n = 4;\n              return res.json();\n            case 4:\n              data = _context3.v;\n              if (data.text) {\n                _this2.inputText = data.text;\n                _this2.lastWasVoice = true;\n                _this2.sendMessage();\n              }\n              _context3.n = 6;\n              break;\n            case 5:\n              _context3.p = 5;\n              _t2 = _context3.v;\n              console.error('Whisper 에러:', _t2);\n            case 6:\n              _context3.p = 6;\n              _this2.isTranscribing = false;\n              _this2.audioChunks = [];\n              return _context3.f(6);\n            case 7:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[2, 5, 6, 7]]);\n      }))();\n    },\n    sendMessage: function sendMessage() {\n      var text = this.inputText.trim();\n      if (!text) return;\n      this.$emit('send', {\n        text: text,\n        isVoice: this.lastWasVoice\n      });\n      this.inputText = '';\n      this.lastWasVoice = false;\n      if (this.showKeyboard) this.showKeyboard = false;\n    },\n    selectHint: function selectHint(hint) {\n      this.inputText = hint;\n      this.sendMessage();\n    }\n  }\n};","map":{"version":3,"names":["VirtualKeyboard","name","components","emits","data","inputText","isRecording","isTranscribing","mediaRecorder","audioChunks","lastWasVoice","showKeyboard","hintCategories","label","icon","color","items","text","full","isDanger","computed","micAvailable","navigator","mediaDevices","getUserMedia","placeholderText","methods","toggleRecording","stopRecording","startRecording","_this","_asyncToGenerator","_regenerator","m","_callee2","stream","_t","w","_context2","p","n","a","audio","v","MediaRecorder","ondataavailable","e","push","onstop","_callee","_context","getTracks","forEach","t","stop","sendAudioToWhisper","start","console","warn","_this2","_callee3","blob","formData","res","_t2","_context3","length","Blob","type","FormData","append","fetch","method","body","json","sendMessage","error","f","trim","$emit","isVoice","selectHint","hint"],"sources":["src/components/InputArea.vue"],"sourcesContent":["<template>\r\n  <div class=\"input-area\">\r\n    <!-- Quick hint chips optimized for visibility -->\r\n    <div class=\"hint-container\">\r\n      <div v-for=\"cat in hintCategories\" :key=\"cat.label\" class=\"hint-group\">\r\n        <div class=\"hint-group-header\">\r\n          <span class=\"material-icons group-icon\" :style=\"{ color: cat.color }\">{{ cat.icon }}</span>\r\n          <span class=\"group-label\">{{ cat.label }}</span>\r\n        </div>\r\n        <div class=\"hint-chips\">\r\n          <button\r\n            v-for=\"item in cat.items\"\r\n            :key=\"item.full\"\r\n            class=\"hint-chip\"\r\n            :class=\"{ 'danger-chip': item.isDanger }\"\r\n            @click=\"selectHint(item.full)\"\r\n          >\r\n            <span class=\"material-icons chip-inner-icon\">{{ item.icon }}</span>\r\n            {{ item.text }}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Main input row -->\r\n    <div class=\"input-row\">\r\n      <!-- Mic Button -->\r\n      <button\r\n        class=\"mic-btn\"\r\n        :class=\"{ recording: isRecording, transcribing: isTranscribing, 'mic-unavailable': !micAvailable }\"\r\n        @click=\"toggleRecording\"\r\n        :disabled=\"isTranscribing\"\r\n      >\r\n        <span class=\"material-icons mic-icon\">\r\n          {{ isTranscribing ? 'autorenew' : isRecording ? 'mic' : 'mic_none' }}\r\n        </span>\r\n        <div v-if=\"isRecording\" class=\"pulse-ring\"></div>\r\n      </button>\r\n\r\n      <!-- Text Input -->\r\n      <div class=\"input-wrapper\">\r\n        <input\r\n          ref=\"textInput\"\r\n          :value=\"inputText\"\r\n          @input=\"inputText = $event.target.value\"\r\n          class=\"text-input\"\r\n          :placeholder=\"placeholderText\"\r\n          @keydown.enter=\"sendMessage\"\r\n          @click=\"showKeyboard = true\"\r\n          inputmode=\"none\"\r\n          :disabled=\"isRecording || isTranscribing\"\r\n        />\r\n        <div v-if=\"isTranscribing\" class=\"recording-indicator\" style=\"color:#00e5ff\">\r\n          WHISPER\r\n        </div>\r\n      </div>\r\n\r\n\r\n\r\n      <!-- Send Button -->\r\n      <button class=\"send-btn\" @click=\"sendMessage\" :disabled=\"!inputText.trim() && !isRecording\">\r\n        <span class=\"material-icons\">send</span>\r\n        <span class=\"send-label\">SEND</span>\r\n      </button>\r\n    </div>\r\n\r\n    <!-- 커스텀 가상 키보드 -->\r\n    <VirtualKeyboard\r\n      :visible=\"showKeyboard\"\r\n      v-model=\"inputText\"\r\n      @send=\"sendMessage\"\r\n      @close=\"showKeyboard = false\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport VirtualKeyboard from './VirtualKeyboard.vue';\r\n\r\nexport default {\r\n  name: 'InputArea',\r\n  components: { VirtualKeyboard },\r\n  emits: ['send'],\r\n  data() {\r\n    return {\r\n      inputText: '',\r\n      isRecording: false,\r\n      isTranscribing: false,\r\n      mediaRecorder: null,\r\n      audioChunks: [],\r\n      lastWasVoice: false,\r\n      showKeyboard: false,\r\n      hintCategories: [\r\n        {\r\n          label: '작업지시',\r\n          icon: 'assignment',\r\n          color: '#00e5ff',\r\n          items: [\r\n            { text: '조회', full: '작업지시 조회', icon: 'search' },\r\n            { text: '추가', full: '작업지시 추가', icon: 'add' },\r\n            { text: '수정', full: '작업지시 수정', icon: 'edit' },\r\n            { text: '삭제', full: '작업지시 삭제', icon: 'delete', isDanger: true },\r\n          ]\r\n        },\r\n        {\r\n          label: '생산실적',\r\n          icon: 'analytics',\r\n          color: '#00ff88',\r\n          items: [\r\n            { text: '조회', full: '생산실적 조회', icon: 'list_alt' },\r\n            { text: '입력', full: '생산실적 입력', icon: 'playlist_add_check' },\r\n            { text: '수정', full: '생산실적 수정', icon: 'history_edu' },\r\n            { text: '삭제', full: '생산실적 삭제', icon: 'backspace', isDanger: true },\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    micAvailable() {\r\n      return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia)\r\n    },\r\n    placeholderText() {\r\n      if (this.isTranscribing) return '🤖 Whisper 변환 중...'\r\n      if (this.isRecording) return '🎤 음성을 듣고 있습니다...'\r\n      return '명령을 입력하거나 🎤 마이크를 누르세요...'\r\n    }\r\n  },\r\n  methods: {\r\n    toggleRecording() {\r\n      if (this.isRecording) this.stopRecording();\r\n      else this.startRecording();\r\n    },\r\n\r\n    async startRecording() {\r\n      if (!this.micAvailable || this.isRecording || this.isTranscribing) return;\r\n      try {\r\n        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\r\n        this.audioChunks = [];\r\n        this.mediaRecorder = new MediaRecorder(stream);\r\n        this.mediaRecorder.ondataavailable = (e) => this.audioChunks.push(e.data);\r\n        this.mediaRecorder.onstop = async () => {\r\n          stream.getTracks().forEach(t => t.stop());\r\n          await this.sendAudioToWhisper();\r\n        };\r\n        this.mediaRecorder.start();\r\n        this.isRecording = true;\r\n      } catch (e) {\r\n        console.warn('마이크 에러:', e);\r\n        this.isRecording = false;\r\n      }\r\n    },\r\n\r\n    stopRecording() {\r\n      if (this.mediaRecorder && this.isRecording) {\r\n        this.mediaRecorder.stop();\r\n        this.isRecording = false;\r\n      }\r\n    },\r\n\r\n    async sendAudioToWhisper() {\r\n      if (this.audioChunks.length === 0) return;\r\n      this.isTranscribing = true;\r\n      try {\r\n        const blob = new Blob(this.audioChunks, { type: 'audio/webm' });\r\n        const formData = new FormData();\r\n        formData.append('audio', blob, 'recording.webm');\r\n        const res = await fetch('http://localhost:5000/api/transcribe', { method: 'POST', body: formData });\r\n        const data = await res.json();\r\n        if (data.text) {\r\n          this.inputText = data.text;\r\n          this.lastWasVoice = true;\r\n          this.sendMessage();\r\n        }\r\n      } catch (e) {\r\n        console.error('Whisper 에러:', e);\r\n      } finally {\r\n        this.isTranscribing = false;\r\n        this.audioChunks = [];\r\n      }\r\n    },\r\n\r\n    sendMessage() {\r\n      const text = this.inputText.trim();\r\n      if (!text) return;\r\n      this.$emit('send', { text, isVoice: this.lastWasVoice });\r\n      this.inputText = '';\r\n      this.lastWasVoice = false;\r\n      if (this.showKeyboard) this.showKeyboard = false;\r\n    },\r\n\r\n    selectHint(hint) {\r\n      this.inputText = hint;\r\n      this.sendMessage();\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n\r\n<style scoped>\r\n.input-area {\r\n  background: #161b22;\r\n  border-top: 1px solid #21262d;\r\n  padding: 10px 16px 12px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* === HINT SYSTEM (RESTRUCTURED) === */\r\n.hint-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.hint-group {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 15px;\r\n}\r\n\r\n.hint-group-header {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  min-width: 60px;\r\n  gap: 2px;\r\n}\r\n\r\n.group-icon {\r\n  font-size: 20px;\r\n}\r\n\r\n.group-label {\r\n  font-size: 10px;\r\n  font-weight: 800;\r\n  color: #8b949e;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.hint-chips {\r\n  display: flex;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  flex: 1;\r\n}\r\n\r\n.hint-chip {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  background: #1c2333;\r\n  border: 1px solid #30363d;\r\n  border-radius: 10px;\r\n  color: #c9d1d9;\r\n  font-size: 12px;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  padding: 6px 12px;\r\n  cursor: pointer;\r\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\r\n  font-weight: 500;\r\n}\r\n\r\n.chip-inner-icon {\r\n  font-size: 14px;\r\n  color: #8b949e;\r\n}\r\n\r\n.hint-chip:hover {\r\n  border-color: #00e5ff;\r\n  color: #00e5ff;\r\n  background: #00e5ff11;\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.hint-chip:hover .chip-inner-icon {\r\n  color: #00e5ff;\r\n}\r\n\r\n.danger-chip:hover {\r\n  border-color: #ff4757;\r\n  color: #ff4757;\r\n  background: #ff475711;\r\n}\r\n.danger-chip:hover .chip-inner-icon {\r\n  color: #ff4757;\r\n}\r\n\r\n/* === INPUT ROW === */\r\n.input-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n\r\n\r\n\r\n/* === MIC BUTTON === */\r\n.mic-btn {\r\n  position: relative;\r\n  width: 56px;\r\n  height: 56px;\r\n  border-radius: 50%;\r\n  border: 2px solid #30363d;\r\n  background: #1c2333;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: all 0.2s;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.mic-btn:hover:not(.recording):not(.mic-unavailable) {\r\n  border-color: #00e5ff;\r\n  background: #00e5ff11;\r\n}\r\n\r\n.mic-btn.recording {\r\n  background: #ff1a2e;\r\n  border-color: #ff1a2e;\r\n  box-shadow: 0 0 20px #ff1a2e66;\r\n}\r\n\r\n.mic-btn.mic-unavailable {\r\n  opacity: 0.4;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.mic-btn.transcribing {\r\n  background: #0d2a4a;\r\n  border-color: #00e5ff;\r\n  box-shadow: 0 0 20px #00e5ff44;\r\n  cursor: wait;\r\n}\r\n\r\n.mic-btn.transcribing .mic-icon {\r\n  color: #00e5ff;\r\n  animation: spin 1s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n  from { transform: rotate(0deg); }\r\n  to   { transform: rotate(360deg); }\r\n}\r\n\r\n.mic-icon {\r\n  font-size: 26px;\r\n  color: #c9d1d9;\r\n  z-index: 1;\r\n  position: relative;\r\n}\r\n.recording .mic-icon { color: #fff; }\r\n\r\n/* Pulse animation for recording */\r\n.pulse-ring {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform: translate(-50%, -50%);\r\n  border-radius: 50%;\r\n  border: 2px solid #ff1a2e;\r\n  animation: mic-pulse 1.5s infinite ease-out;\r\n  pointer-events: none;\r\n}\r\n.pulse-ring-2 {\r\n  animation-delay: 0.5s;\r\n}\r\n@keyframes mic-pulse {\r\n  0%   { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }\r\n  100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }\r\n}\r\n\r\n/* === TEXT INPUT === */\r\n.input-wrapper {\r\n  flex: 1;\r\n  position: relative;\r\n}\r\n\r\n.text-input {\r\n  width: 100%;\r\n  background: #0d1117;\r\n  border: 1px solid #30363d;\r\n  border-radius: 8px;\r\n  color: #c9d1d9;\r\n  font-size: 15px;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  padding: 14px 16px;\r\n  outline: none;\r\n  transition: border-color 0.2s;\r\n}\r\n.text-input::placeholder { color: #484f58; }\r\n.text-input:focus { border-color: #00e5ff; }\r\n.text-input:disabled { opacity: 0.6; }\r\n\r\n.recording-indicator {\r\n  position: absolute;\r\n  right: 12px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  color: #ff4757;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.rec-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  background: #ff4757;\r\n  border-radius: 50%;\r\n  animation: blink 1s infinite;\r\n}\r\n@keyframes blink {\r\n  0%, 100% { opacity: 1; }\r\n  50%       { opacity: 0; }\r\n}\r\n\r\n/* === SEND BUTTON === */\r\n.send-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 14px 22px;\r\n  background: linear-gradient(135deg, #00b4cc, #00e5ff);\r\n  border: none;\r\n  border-radius: 8px;\r\n  color: #0d1117;\r\n  font-size: 13px;\r\n  font-weight: 900;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  letter-spacing: 1.5px;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n  flex-shrink: 0;\r\n}\r\n.send-btn:hover:not(:disabled