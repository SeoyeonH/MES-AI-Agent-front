tory_edu'\n        }, {\n          text: '삭제',\n          full: '생산실적 삭제',\n          icon: 'backspace',\n          isDanger: true\n        }]\n      }]\n    };\n  },\n  computed: {\n    micAvailable: function micAvailable() {\n      return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);\n    },\n    placeholderText: function placeholderText() {\n      if (this.isTranscribing) return '🤖 Whisper 변환 중...';\n      if (this.isRecording) return '🎤 음성을 듣고 있습니다...';\n      return '명령을 입력하거나 🎤 마이크를 누르세요...';\n    }\n  },\n  methods: {\n    toggleRecording: function toggleRecording() {\n      if (this.isRecording) this.stopRecording();else this.startRecording();\n    },\n    startRecording: function startRecording() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        var stream, _t;\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.p = _context2.n) {\n            case 0:\n              if (!(!_this.micAvailable || _this.isRecording || _this.isTranscribing)) {\n                _context2.n = 1;\n                break;\n              }\n              return _context2.a(2);\n            case 1:\n              _context2.p = 1;\n              _context2.n = 2;\n              return navigator.mediaDevices.getUserMedia({\n                audio: true\n              });\n            case 2:\n              stream = _context2.v;\n              _this.audioChunks = [];\n              _this.mediaRecorder = new MediaRecorder(stream);\n              _this.mediaRecorder.ondataavailable = function (e) {\n                return _this.audioChunks.push(e.data);\n              };\n              _this.mediaRecorder.onstop = /*#__PURE__*/_asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n                return _regenerator().w(function (_context) {\n                  while (1) switch (_context.n) {\n                    case 0:\n                      st