{"ast":null,"code":"export default {\n  name: 'DashboardBar',\n  props: {\n    kpi: {\n      type: Object,\n      required: true\n    }\n  },\n  computed: {\n    productionRate: function productionRate() {\n      return Math.round(this.kpi.production.value / this.kpi.production.target * 100);\n    },\n    productionRateColor: function productionRateColor() {\n      return this.productionRate >= 90 ? 'color-green' : this.productionRate >= 70 ? 'color-yellow' : 'color-red';\n    },\n    productionBarColor: function productionBarColor() {\n      return this.productionRate >= 90 ? '#00ff88' : this.productionRate >= 70 ? '#ffa502' : '#ff4757';\n    },\n    defectColor: function defectColor() {\n      return this.kpi.defectRate.value > this.kpi.defectRate.threshold ? 'color-red' : 'color-green';\n    },\n    defectBarColor: function defectBarColor() {\n      return this.kpi.defectRate.value > this.kpi.defectRate.threshold ? '#ff4757' : '#00ff88';\n    }\n  }\n};","map":{"version":3,"names":["name","props","kpi","type","Object","required","computed","productionRate","Math","round","production","value","target","productionRateColor","productionBarColor","defectColor","defectRate","threshold","defectBarColor"],"sources":["src/components/DashboardBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-bar\">\r\n    <!-- 오늘 생산량 -->\r\n    <div class=\"kpi-card\">\r\n      <div class=\"kpi-label\">오늘 생산량</div>\r\n      <div class=\"kpi-value\" style=\"color:#00e5ff\">\r\n        {{ kpi.production.value.toLocaleString() }}\r\n        <span class=\"kpi-unit\">{{ kpi.production.unit }}</span>\r\n      </div>\r\n      <div class=\"kpi-sub\">\r\n        목표 {{ kpi.production.target.toLocaleString() }} /\r\n        달성률 <span :class=\"productionRateColor\">{{ productionRate }}%</span>\r\n      </div>\r\n      <div class=\"kpi-bar-track\">\r\n        <div class=\"kpi-bar-fill\" :style=\"{ width: productionRate + '%', background: productionBarColor }\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 불량률 -->\r\n    <div class=\"kpi-card\" :class=\"{ 'kpi-warn': kpi.defectRate.value > kpi.defectRate.threshold }\">\r\n      <div class=\"kpi-label\">불량률</div>\r\n      <div class=\"kpi-value\" :class=\"defectColor\">\r\n        {{ kpi.defectRate.value }}\r\n        <span class=\"kpi-unit\">{{ kpi.defectRate.unit }}</span>\r\n      </div>\r\n      <div class=\"kpi-sub\">\r\n        기준 {{ kpi.defectRate.threshold }}%\r\n        <span v-if=\"kpi.defectRate.value > kpi.defectRate.threshold\" class=\"warn-badge\">⚠ 초과</span>\r\n      </div>\r\n      <div class=\"kpi-bar-track\">\r\n        <div class=\"kpi-bar-fill\" :style=\"{ width: Math.min(kpi.defectRate.value / 5 * 100, 100) + '%', background: defectBarColor }\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 진행중 작업지시 -->\r\n    <div class=\"kpi-card\">\r\n      <div class=\"kpi-label\">진행중 작업지시</div>\r\n      <div class=\"kpi-value\" style=\"color:#00e5ff\">\r\n        {{ kpi.workOrders.active }}\r\n        <span class=\"kpi-unit\">건</span>\r\n      </div>\r\n      <div class=\"kpi-sub\">\r\n        대기 {{ kpi.workOrders.waiting }} / 완료 {{ kpi.workOrders.done }}\r\n      </div>\r\n      <div class=\"kpi-progress-dots\">\r\n        <span v-for=\"i in kpi.workOrders.active\" :key=\"'a'+i\" class=\"dot dot-active\"></span>\r\n        <span v-for=\"i in kpi.workOrders.waiting\" :key=\"'w'+i\" class=\"dot dot-wait\"></span>\r\n        <span v-for=\"i in kpi.workOrders.done\" :key=\"'d'+i\" class=\"dot dot-done\"></span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 가동 라인 수 -->\r\n    <div class=\"kpi-card\">\r\n      <div class=\"kpi-label\">가동 라인 수</div>\r\n      <div class=\"kpi-value\" style=\"color:#00ff88\">\r\n        {{ kpi.activeLines.current }}\r\n        <span class=\"kpi-unit\" style=\"color:#8b949e\">/ {{ kpi.activeLines.total }}</span>\r\n      </div>\r\n      <div class=\"kpi-sub\">\r\n        전 라인 정상 가동\r\n      </div>\r\n      <div class=\"kpi-progress-dots\">\r\n        <span v-for=\"i in kpi.activeLines.total\" :key=\"i\"\r\n          class=\"dot-line\" :class=\"i <= kpi.activeLines.current ? 'dot-line-on' : 'dot-line-off'\">\r\n          {{ i }}라인\r\n        </span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 설비 가동률 -->\r\n    <div class=\"kpi-card\">\r\n      <div class=\"kpi-label\">설비 가동률</div>\r\n      <div class=\"kpi-value\" style=\"color:#00ff88\">\r\n        {{ kpi.utilization.value }}\r\n        <span class=\"kpi-unit\">{{ kpi.utilization.unit }}</span>\r\n      </div>\r\n      <div class=\"kpi-sub\">목표 {{ kpi.utilization.target }}% 달성</div>\r\n      <div class=\"kpi-bar-track\">\r\n        <div class=\"kpi-bar-fill\" :style=\"{ width: kpi.utilization.value + '%', background: '#00ff88' }\"></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'DashboardBar',\r\n  props: { kpi: { type: Object, required: true } },\r\n  computed: {\r\n    productionRate() {\r\n      return Math.round(this.kpi.production.value / this.kpi.production.target * 100)\r\n    },\r\n    productionRateColor() {\r\n      return this.productionRate >= 90 ? 'color-green' : this.productionRate >= 70 ? 'color-yellow' : 'color-red'\r\n    },\r\n    productionBarColor() {\r\n      return this.productionRate >= 90 ? '#00ff88' : this.productionRate >= 70 ? '#ffa502' : '#ff4757'\r\n    },\r\n    defectColor() {\r\n      return this.kpi.defectRate.value > this.kpi.defectRate.threshold ? 'color-red' : 'color-green'\r\n    },\r\n    defectBarColor() {\r\n      return this.kpi.defectRate.value > this.kpi.defectRate.threshold ? '#ff4757' : '#00ff88'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-bar {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 8px 16px;\r\n  background: #0d1117;\r\n  border-bottom: 1px solid #21262d;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.kpi-card {\r\n  flex: 1;\r\n  background: #161b22;\r\n  border: 1px solid #21262d;\r\n  border-radius: 8px;\r\n  padding: 10px 14px;\r\n  min-width: 0;\r\n  transition: border-color 0.3s;\r\n}\r\n.kpi-card:hover {\r\n  border-color: #00e5ff44;\r\n}\r\n.kpi-card.kpi-warn {\r\n  border-color: #ffa502;\r\n  background: #1e1a10;\r\n}\r\n\r\n.kpi-label {\r\n  font-size: 10px;\r\n  font-weight: 600;\r\n  color: #8b949e;\r\n  letter-spacing: 1.5px;\r\n  text-transform: uppercase;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.kpi-value {\r\n  font-size: 26px;\r\n  font-weight: 900;\r\n  line-height: 1.1;\r\n  font-family: 'Roboto Mono', monospace;\r\n}\r\n\r\n.kpi-unit {\r\n  font-size: 13px;\r\n  font-weight: 400;\r\n  color: #8b949e;\r\n  margin-left: 2px;\r\n}\r\n\r\n.kpi-sub {\r\n  font-size: 11px;\r\n  color: #8b949e;\r\n  margin-top: 3px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.warn-badge {\r\n  background: #ffa502;\r\n  color: #0d1117;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  padding: 1px 5px;\r\n  border-radius: 3px;\r\n  margin-left: 4px;\r\n}\r\n\r\n.kpi-bar-track {\r\n  height: 4px;\r\n  background: #30363d;\r\n  border-radius: 2px;\r\n  overflow: hidden;\r\n}\r\n.kpi-bar-fill {\r\n  height: 100%;\r\n  border-radius: 2px;\r\n  transition: width 1s ease;\r\n}\r\n\r\n.kpi-progress-dots {\r\n  display: flex;\r\n  gap: 4px;\r\n  flex-wrap: wrap;\r\n  margin-top: 2px;\r\n}\r\n.dot {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n}\r\n.dot-active { background: #00e5ff; box-shadow: 0 0 4px #00e5ff; }\r\n.dot-wait   { background: #ffa502; }\r\n.dot-done   { background: #30363d; }\r\n\r\n.dot-line {\r\n  font-size: 9px;\r\n  font-weight: 700;\r\n  padding: 2px 6px;\r\n  border-radius: 3px;\r\n  letter-spacing: 0.5px;\r\n}\r\n.dot-line-on  { background: #00ff8822; color: #00ff88; border: 1px solid #00ff88; }\r\n.dot-line-off { background: #30363d22; color: #8b949e; border: 1px solid #30363d; }\r\n\r\n.color-green { color: #00ff88 !important; }\r\n.color-yellow { color: #ffa502 !important; }\r\n.color-red { color: #ff4757 !important; }\r\n</style>\r\n"],"mappings":"AAqFA;EACAA,IAAA;EACAC,KAAA;IAAAC,GAAA;MAAAC,IAAA,EAAAC,MAAA;MAAAC,QAAA;IAAA;EAAA;EACAC,QAAA;IACAC,cAAA,WAAAA,eAAA;MACA,OAAAC,IAAA,CAAAC,KAAA,MAAAP,GAAA,CAAAQ,UAAA,CAAAC,KAAA,QAAAT,GAAA,CAAAQ,UAAA,CAAAE,MAAA;IACA;IACAC,mBAAA,WAAAA,oBAAA;MACA,YAAAN,cAAA,8BAAAA,cAAA;IACA;IACAO,kBAAA,WAAAA,mBAAA;MACA,YAAAP,cAAA,0BAAAA,cAAA;IACA;IACAQ,WAAA,WAAAA,YAAA;MACA,YAAAb,GAAA,CAAAc,UAAA,CAAAL,KAAA,QAAAT,GAAA,CAAAc,UAAA,CAAAC,SAAA;IACA;IACAC,cAAA,WAAAA,eAAA;MACA,YAAAhB,GAAA,CAAAc,UAAA,CAAAL,KAAA,QAAAT,GAAA,CAAAc,UAAA,CAAAC,SAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}