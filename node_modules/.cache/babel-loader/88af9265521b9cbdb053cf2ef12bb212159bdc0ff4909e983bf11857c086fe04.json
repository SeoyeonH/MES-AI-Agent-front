{"ast":null,"code":"import \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.string.replace.js\";\nimport ResultCard from './ResultCard.vue';\nexport default {\n  name: 'MessageBubble',\n  components: {\n    ResultCard: ResultCard\n  },\n  props: {\n    message: {\n      type: Object,\n      required: true\n    }\n  },\n  emits: ['confirm', 'cancel'],\n  methods: {\n    formatText: function formatText(text) {\n      return text.replace(/\\n/g, '<br>').replace(/•/g, '<br>•');\n    }\n  }\n};","map":{"version":3,"names":["ResultCard","name","components","props","message","type","Object","required","emits","methods","formatText","text","replace"],"sources":["src/components/MessageBubble.vue"],"sourcesContent":["<template>\r\n  <div class=\"bubble-wrapper\" :class=\"message.role === 'user' ? 'user-wrapper' : 'ai-wrapper'\">\r\n\r\n    <!-- AI Avatar -->\r\n    <div v-if=\"message.role === 'ai'\" class=\"ai-avatar\">AI</div>\r\n\r\n    <div class=\"bubble-col\" :class=\"message.role === 'user' ? 'col-user' : 'col-ai'\">\r\n\r\n      <!-- User Bubble -->\r\n      <div v-if=\"message.role === 'user'\" class=\"user-bubble\">\r\n        <span v-if=\"message.isVoice\" class=\"voice-icon\">🎤</span>\r\n        {{ message.text }}\r\n      </div>\r\n\r\n      <!-- AI Bubble -->\r\n      <div v-else class=\"ai-bubble\">\r\n        <div v-if=\"message.type === 'text'\" class=\"ai-text\" v-html=\"formatText(message.text)\"></div>\r\n        <ResultCard\r\n          v-else\r\n          :message=\"message\"\r\n          @confirm=\"$emit('confirm')\"\r\n          @cancel=\"$emit('cancel')\"\r\n        />\r\n      </div>\r\n\r\n      <div class=\"msg-time\" :class=\"message.role === 'user' ? 'time-right' : 'time-left'\">\r\n        {{ message.time }}\r\n      </div>\r\n    </div>\r\n\r\n    <!-- User Avatar -->\r\n    <div v-if=\"message.role === 'user'\" class=\"user-avatar\">나</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport ResultCard from './ResultCard.vu