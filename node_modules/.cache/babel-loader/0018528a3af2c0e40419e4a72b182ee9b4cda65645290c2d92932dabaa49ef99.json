{"ast":null,"code":"export default {\n  name: 'LineStatusBar',\n  props: {\n    lines: {\n      type: Array,\n      required: true\n    }\n  },\n  methods: {\n    statusColor: function statusColor(status) {\n      if (status === '가동중') return '#00ff88';\n      if (status === '준비중') return '#ffa502';\n      return '#ff4757';\n    },\n    statusClass: function statusClass(status) {\n      if (status === '가동중') return 'badge-green';\n      if (status === '준비중') return 'badge-yellow';\n      return 'badge-red';\n    }\n  }\n};","map":{"version":3,"names":["name","props","lines","type","Array","required","methods","statusColor","status","statusClass"],"sources":["src/components/LineStatusBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"line-status-bar\">\r\n    <div v-for=\"line in lines\" :key=\"line.name\" class=\"line-row\">\r\n      <div class=\"line-info\">\r\n        <span class=\"line-name\">{{ line.name }}</span>\r\n        <span class=\"line-pct\" :style=\"{ color: statusColor(line.status) }\">{{ line.progress }}%</span>\r\n        <span class=\"line-badge\" :class=\"statusClass(line.status)\">{{ line.status }}</span>\r\n      </div>\r\n      <div class=\"line-track\">\r\n        <div\r\n          class=\"line-fill\"\r\n          :style=\"{ width: line.progress + '%', background: statusColor(line.status) }\"\r\n        ></div>\r\n        <div class=\"line-glow\" :style=\"{ width: line.progress + '%', background: statusColor(line.status) }\"></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'LineStatusBar',\r\n  props: {\r\n    lines: { type: Array, required: true }\r\n  },\r\n  methods: {\r\n    statusColor(status) {\r\n      if (status === '가동중') return '#00ff88'\r\n      if (status === '준비중') return '#ffa502'\r\n      return '#ff4757'\r\n    },\r\n    statusClass(status) {\r\n      if (status === '가동중') return 'badge-green'\r\n      if (status === '준비중') return 'badge-yellow'\r\n      return 'badge-red'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.line-status-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0;\r\n  padding: 6px 16px;\r\n  background: #0d1117;\r\n  border-bottom: 1px solid #21262d;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.line-row {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 0 12px;\r\n  border-right: 1px solid #21262d;\r\n}\r\n.line-row:last-child {\r\n  border-right: none;\r\n}\r\n\r\n.line-info {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-shrink: 0;\r\n  min-width: 140px;\r\n}\r\n\r\n.line-name {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #c9d1d9;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.line-pct {\r\n  font-family: 'Roboto Mono', monospace;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.line-badge {\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  padding: 2px 7px;\r\n  border-radius: 3px;\r\n  letter-spacing: 0.5px;\r\n}\r\n.badge-green  { background: #00ff8822; color: #00ff88; border: 1px solid #00ff88; }\r\n.badge-yellow { background: #ffa50222; color: #ffa502; border: 1px solid #ffa502; }\r\n.badge-red    { background: #ff475722; color: #ff4757; border: 1px solid #ff4757; }\r\n\r\n.line-track {\r\n  flex: 1;\r\n  height: 8px;\r\n  background: #21262d;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.line-fill {\r\n  height: 100%;\r\n  border-radius: 4px;\r\n  transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.line-glow {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  height: 100%;\r\n  border-radius: 4px;\r\n  opacity: 0.3;\r\n  filter: blur(4px);\r\n  transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);\r\n  pointer-events: none;\r\n}\r\n</style>\r\n"],"mappings":"AAoBA;EACAA,IAAA;EACAC,KAAA;IACAC,KAAA;MAAAC,IAAA,EAAAC,KAAA;MAAAC,QAAA;IAAA;EACA;EACAC,OAAA;IACAC,WAAA,WAAAA,YAAAC,MAAA;MACA,IAAAA,MAAA;MACA,IAAAA,MAAA;MACA;IACA;IACAC,WAAA,WAAAA,YAAAD,MAAA;MACA,IAAAA,MAAA;MACA,IAAAA,MAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}