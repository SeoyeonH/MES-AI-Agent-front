{"ast":null,"code":"export default {\n  name: 'TouchKeyboard',\n  props: {\n    value: {\n      type: String,\n      \"default\": ''\n    },\n    visible: {\n      type: Boolean,\n      \"default\": false\n    }\n  },\n  emits: ['append', 'backspace', 'send', 'clear', 'close'],\n  data: function data() {\n    return {\n      lines: ['1라인', '2라인', '3라인'],\n      products: ['A형 부품', 'B형 부품', 'C형 부품', 'A형 조립품', 'B형 조립품', 'C형 조립품', 'A형 모듈', 'B형 모듈', 'C형 모듈'],\n      actions: [{\n        label: '조회',\n        text: '조회해줘',\n        cls: 'kb-chip-action-blue'\n      }, {\n        label: '추가',\n        text: '추가해줘',\n        cls: 'kb-chip-action-green'\n      }, {\n        label: '수정',\n        text: '수정해줘',\n        cls: 'kb-chip-action-yellow'\n      }, {\n        label: '실적 입력',\n        text: '실적 입력해줘',\n        cls: 'kb-chip-action-purple'\n      }, {\n        label: '현황 조회',\n        text: '전체 현황 보여줘',\n        cls: 'kb-chip-action-blue'\n      }],\n      statuses: [{\n        label: '시작',\n        text: '시작해줘',\n        cls: 'kb-chip-status-green'\n      }, {\n        label: '완료',\n        text: '완료해줘',\n        cls: 'kb-chip-status-cyan'\n      }, {\n        label: '대기',\n        text: '대기해줘',\n        cls: 'kb-chip-status-yellow'\n      }, {\n        label: '중단',\n        text: '중단해줘',\n        cls: 'kb-chip-status-red'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","props","value","type","String","visible","Boolean","emits","data","lines","products","actions","label","text","cls","statuses"],"sources":["src/components/TouchKeyboard.vue"],"sourcesContent":["<template>\r\n  <div class=\"kb-overlay\" @click.self=\"$emit('close')\">\r\n    <div class=\"kb-panel\" :class=\"{ 'kb-visible': visible }\">\r\n\r\n      <!-- 헤더 -->\r\n      <div class=\"kb-header\">\r\n        <div class=\"kb-header-left\">\r\n          <span class=\"material-icons kb-header-icon\">touch_app</span>\r\n          <span class=\"kb-title\">MES 터치 입력</span>\r\n        </div>\r\n        <!-- 입력 미리보기 -->\r\n        <div class=\"kb-preview-wrap\">\r\n          <span class=\"kb-preview\" :class=\"{ 'kb-preview-empty': !value }\">\r\n            {{ value || '터치하여 명령을 조합하세요...' }}\r\n          </span>\r\n          <button v-if=\"value\" class=\"kb-clear-btn\" @click=\"$emit('clear')\">\r\n            <span class=\"material-icons\">backspace</span>\r\n          </button>\r\n        </div>\r\n        <button class=\"kb-close-btn\" @click=\"$emit('close')\">\r\n          <span class=\"material-icons\">close</span>\r\n        </button>\r\n      </div>\r\n\r\n      <div class=\"kb-body\">\r\n\r\n        <!-- 섹션: 라인 -->\r\n        <div class=\"kb-section\">\r\n          <div class=\"kb-section-label\">\r\n            <span class=\"material-icons kb-label-icon\">factory</span>라인\r\n          </div>\r\n          <div class=\"kb-row\">\r\n            <button\r\n              v-for=\"line in lines\"\r\n              :key=\"line\"\r\n              class=\"kb-chip kb-chip-line\"\r\n              @click=\"$emit('append', line)\"\r\n            >{{ line }}</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 섹션: 제품 -->\r\n        <div class=\"kb-section\">\r\n          <div class=\"kb-section-label\">\r\n            <span class=\"material-icons kb-label-icon\">inventory_2</span>제품\r\n          </div>\r\n          <div class=\"kb-row kb-row-wrap\">\r\n            <button\r\n              v-for=\"p in products\"\r\n              :key=\"p\"\r\n              class=\"kb-chip kb-chip-product\"\r\n              @click=\"$emit('append', p)\"\r\n            >{{ p }}</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 섹션: 동작 -->\r\n        <div class=\"kb-section\">\r\n          <div class=\"kb-section-label\">\r\n            <span class=\"material-icons kb-label-icon\">play_circle</span>동작\r\n          </div>\r\n          <div class=\"kb-row\">\r\n            <button\r\n              v-for=\"a in actions\"\r\n              :key=\"a.label\"\r\n              class=\"kb-chip\"\r\n              :class=\"a.cls\"\r\n              @click=\"$emit('append', a.text)\"\r\n            >{{ a.label }}</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 섹션: 상태 -->\r\n        <div class=\"kb-section\">\r\n          <div class=\"kb-section-label\">\r\n            <span class=\"material-icons kb-label-icon\">toggle_on</span>상태\r\n          </div>\r\n          <div class=\"kb-row\">\r\n            <button\r\n              v-for=\"s in statuses\"\r\n              :key=\"s.label\"\r\n              class=\"kb-chip\"\r\n              :class=\"s.cls\"\r\n              @click=\"$emit('append', s.text)\"\r\n            >{{ s.label }}</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 하단: 숫자패드 + 컨트롤 -->\r\n        <div class=\"kb-bottom\">\r\n\r\n          <!-- 숫자패드 -->\r\n          <div class=\"kb-numpad-wrap\">\r\n            <div class=\"kb-section-label\" style=\"margin-bottom:8px\">\r\n              <span class=\"material-icons kb-label-icon\">tag</span>수량\r\n            </div>\r\n            <div class=\"kb-numpad\">\r\n              <button v-for=\"n in [1,2,3,4,5,6,7,8,9]\" :key=\"n\"\r\n                class=\"kb-num\" @click=\"$emit('append', String(n))\">{{ n }}</button>\r\n              <button class=\"kb-num kb-num-zero\" @click=\"$emit('append', '0')\">0</button>\r\n              <button class=\"kb-num kb-num-unit\" @click=\"$emit('append', '00')\">00</button>\r\n              <button class=\"kb-num kb-num-unit\" @click=\"$emit('append', '개')\">개</button>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 컨트롤 버튼 -->\r\n          <div class=\"kb-controls\">\r\n            <button class=\"kb-ctrl-btn kb-ctrl-space\" @click=\"$emit('append', ' ')\">\r\n              <span class=\"material-icons\">space_bar</span>\r\n              <span>띄어쓰기</span>\r\n            </button>\r\n            <button class=\"kb-ctrl-btn kb-ctrl-back\" @click=\"$emit('backspace')\">\r\n              <span class=\"material-icons\">backspace</span>\r\n              <span>지우기</span>\r\n            </button>\r\n            <button class=\"kb-ctrl-btn kb-ctrl-send\" @click=\"$emit('send')\">\r\n              <span class=\"material-icons\">send</span>\r\n              <span>전송</span>\r\n            </button>\r\n          </div>\r\n\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TouchKeyboard',\r\n  props: {\r\n    value:   { type: String, default: '' },\r\n    visible: { type: Boolean, default: false }\r\n  },\r\n  emits: ['append', 'backspace', 'send', 'clear', 'close'],\r\n  data() {\r\n    return {\r\n      lines: ['1라인', '2라인', '3라인'],\r\n\r\n      products: [\r\n        'A형 부품', 'B형 부품', 'C형 부품',\r\n        'A형 조립품', 'B형 조립품', 'C형 조립품',\r\n        'A형 모듈', 'B형 모듈', 'C형 모듈'\r\n      ],\r\n\r\n      actions: [\r\n        { label: '조회',    text: '조회해줘',    cls: 'kb-chip-action-blue'   },\r\n        { label: '추가',    text: '추가해줘',    cls: 'kb-chip-action-green'  },\r\n        { label: '수정',    text: '수정해줘',    cls: 'kb-chip-action-yellow' },\r\n        { label: '실적 입력', text: '실적 입력해줘', cls: 'kb-chip-action-purple' },\r\n        { label: '현황 조회', text: '전체 현황 보여줘', cls: 'kb-chip-action-blue' }\r\n      ],\r\n\r\n      statuses: [\r\n        { label: '시작',  text: '시작해줘',  cls: 'kb-chip-status-green'  },\r\n        { label: '완료',  text: '완료해줘',  cls: 'kb-chip-status-cyan'   },\r\n        { label: '대기',  text: '대기해줘',  cls: 'kb-chip-status-yellow' },\r\n        { label: '중단',  text: '중단해줘',  cls: 'kb-chip-status-red'    }\r\n      ]\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* ===== OVERLAY ===== */\r\n.kb-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(0, 0, 0, 0.55);\r\n  z-index: 1000;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  backdrop-filter: blur(2px);\r\n}\r\n\r\n/* ===== PANEL ===== */\r\n.kb-panel {\r\n  width: 100%;\r\n  background: #161b22;\r\n  border-top: 1px solid #21262d;\r\n  border-radius: 20px 20px 0 0;\r\n  box-shadow: 0 -8px 40px rgba(0, 229, 255, 0.08);\r\n  transform: translateY(100%);\r\n  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);\r\n  max-height: 80vh;\r\n  overflow-y: auto;\r\n}\r\n.kb-visible {\r\n  transform: translateY(0);\r\n}\r\n\r\n/* ===== HEADER ===== */\r\n.kb-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 14px 16px 10px;\r\n  border-bottom: 1px solid #21262d;\r\n  position: sticky;\r\n  top: 0;\r\n  background: #161b22;\r\n  z-index: 1;\r\n}\r\n.kb-header-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n}\r\n.kb-header-icon {\r\n  font-size: 18px;\r\n  color: #00e5ff;\r\n}\r\n.kb-title {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: #00e5ff;\r\n  letter-spacing: 1.5px;\r\n  text-transform: uppercase;\r\n  font-family: 'Roboto Mono', monospace;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* 입력 미리보기 */\r\n.kb-preview-wrap {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  background: #0d1117;\r\n  border: 1px solid #30363d;\r\n  border-radius: 8px;\r\n  padding: 8px 12px;\r\n  min-width: 0;\r\n}\r\n.kb-preview {\r\n  flex: 1;\r\n  font-size: 14px;\r\n  color: #c9d1d9;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.kb-preview-empty {\r\n  color: #484f58;\r\n}\r\n.kb-clear-btn {\r\n  background: none;\r\n  border: none;\r\n  color: #8b949e;\r\n  cursor: pointer;\r\n  padding: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  flex-shrink: 0;\r\n}\r\n.kb-clear-btn .material-icons { font-size: 16px; }\r\n.kb-clear-btn:hover { color: #ff4757; }\r\n\r\n.kb-close-btn {\r\n  background: none;\r\n  border: none;\r\n  color: #8b949e;\r\n  cursor: pointer;\r\n  padding: 4px;\r\n  display: flex;\r\n  align-items: center;\r\n  border-radius: 6px;\r\n  flex-shrink: 0;\r\n  transition: all 0.2s;\r\n}\r\n.kb-close-btn:hover { background: #ff475722; color: #ff4757; }\r\n.kb-close-btn .material-icons { font-size: 20px; }\r\n\r\n/* ===== BODY ===== */\r\n.kb-body {\r\n  padding: 12px 14px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n/* ===== SECTION ===== */\r\n.kb-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.kb-section-label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  color: #8b949e;\r\n  letter-spacing: 1.5px;\r\n  text-transform: uppercase;\r\n  font-family: 'Roboto Mono', monospace;\r\n}\r\n.kb-label-icon { font-size: 13px; color: #484f58; }\r\n\r\n/* ===== ROWS ===== */\r\n.kb-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: nowrap;\r\n}\r\n.kb-row-wrap {\r\n  flex-wrap: wrap;\r\n}\r\n\r\n/* ===== CHIPS ===== */\r\n.kb-chip {\r\n  border: 1px solid #30363d;\r\n  border-radius: 10px;\r\n  background: #1c2333;\r\n  color: #c9d1d9;\r\n  font-size: 13px;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  font-weight: 600;\r\n  padding: 10px 16px;\r\n  cursor: pointer;\r\n  transition: all 0.15s;\r\n  white-space: nowrap;\r\n  min-height: 44px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  user-select: none;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n.kb-chip:active {\r\n  transform: scale(0.95);\r\n}\r\n\r\n/* 라인 */\r\n.kb-chip-line {\r\n  border-color: #00e5ff44;\r\n  color: #00e5ff;\r\n  background: #00e5ff11;\r\n  flex: 1;\r\n}\r\n.kb-chip-line:hover, .kb-chip-line:active {\r\n  background: #00e5ff22;\r\n  border-color: #00e5ff;\r\n  box-shadow: 0 0 12px #00e5ff33;\r\n}\r\n\r\n/* 제품 */\r\n.kb-chip-product {\r\n  background: #1a2a1a;\r\n  border-color: #00ff8844;\r\n  color: #00ff88;\r\n  font-size: 12px;\r\n  padding: 9px 12px;\r\n}\r\n.kb-chip-product:hover, .kb-chip-product:active {\r\n  background: #00ff8822;\r\n  border-color: #00ff88;\r\n}\r\n\r\n/* 동작 */\r\n.kb-chip-action-blue   { border-color: #00e5ff55; color: #00e5ff; background: #00e5ff0d; }\r\n.kb-chip-action-green  { border-color: #00ff8855; color: #00ff88; background: #00ff880d; }\r\n.kb-chip-action-yellow { border-color: #ffa50255; color: #ffa502; background: #ffa5020d; }\r\n.kb-chip-action-purple { border-color: #bf6fff55; color: #bf6fff; background: #bf6fff0d; }\r\n.kb-chip-action-blue:hover, .kb-chip-action-blue:active     { background: #00e5ff22; border-color: #00e5ff; }\r\n.kb-chip-action-green:hover, .kb-chip-action-green:active   { background: #00ff8822; border-color: #00ff88; }\r\n.kb-chip-action-yellow:hover, .kb-chip-action-yellow:active { background: #ffa50222; border-color: #ffa502; }\r\n.kb-chip-action-purple:hover, .kb-chip-action-purple:active { background: #bf6fff22; border-color: #bf6fff; }\r\n\r\n/* 상태 */\r\n.kb-chip-status-green  { border-color: #00ff8855; color: #00ff88; background: #00ff880d; }\r\n.kb-chip-status-cyan   { border-color: #00e5ff55; color: #00e5ff; background: #00e5ff0d; }\r\n.kb-chip-status-yellow { border-color: #ffa50255; color: #ffa502; background: #ffa5020d; }\r\n.kb-chip-status-red    { border-color: #ff475755; color: #ff4757; background: #ff47570d; }\r\n.kb-chip-status-green:hover, .kb-chip-status-green:active   { background: #00ff8822; border-color: #00ff88; }\r\n.kb-chip-status-cyan:hover, .kb-chip-status-cyan:active     { background: #00e5ff22; border-color: #00e5ff; }\r\n.kb-chip-status-yellow:hover, .kb-chip-status-yellow:active { background: #ffa50222; border-color: #ffa502; }\r\n.kb-chip-status-red:hover, .kb-chip-status-red:active       { background: #ff475722; border-color: #ff4757; }\r\n\r\n/* ===== BOTTOM ===== */\r\n.kb-bottom {\r\n  display: flex;\r\n  gap: 12px;\r\n  align-items: flex-end;\r\n  border-top: 1px solid #21262d;\r\n  padding-top: 12px;\r\n  margin-top: 2px;\r\n}\r\n\r\n/* ===== NUMPAD ===== */\r\n.kb-numpad-wrap { flex: 1; }\r\n.kb-numpad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 6px;\r\n}\r\n.kb-num {\r\n  background: #1c2333;\r\n  border: 1px solid #30363d;\r\n  border-radius: 8px;\r\n  color: #c9d1d9;\r\n  font-size: 16px;\r\n  font-family: 'Roboto Mono', monospace;\r\n  font-weight: 700;\r\n  min-height: 46px;\r\n  cursor: pointer;\r\n  transition: all 0.15s;\r\n  user-select: none;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n.kb-num:hover, .kb-num:active {\r\n  background: #21262d;\r\n  border-color: #00e5ff;\r\n  color: #00e5ff;\r\n  transform: scale(0.96);\r\n}\r\n.kb-num-unit {\r\n  font-size: 13px;\r\n  color: #ffa502;\r\n  border-color: #ffa50244;\r\n  background: #ffa5020d;\r\n}\r\n.kb-num-unit:hover, .kb-num-unit:active {\r\n  background: #ffa50222;\r\n  border-color: #ffa502;\r\n  color: #ffa502;\r\n}\r\n\r\n/* ===== CONTROLS ===== */\r\n.kb-controls {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  flex-shrink: 0;\r\n  width: 90px;\r\n}\r\n.kb-ctrl-btn {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 3px;\r\n  border-radius: 10px;\r\n  border: 1px solid #30363d;\r\n  background: #1c2333;\r\n  color: #8b949e;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  letter-spacing: 0.5px;\r\n  min-height: 50px;\r\n  cursor: pointer;\r\n  transition: all 0.15s;\r\n  user-select: none;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n.kb-ctrl-btn .material-icons { font-size: 18px; }\r\n.kb-ctrl-btn:active { transform: scale(0.95); }\r\n\r\n.kb-ctrl-space {\r\n  border-color: #30363d;\r\n}\r\n.kb-ctrl-space:hover, .kb-ctrl-space:active {\r\n  border-color: #8b949e;\r\n  background: #21262d;\r\n  color: #c9d1d9;\r\n}\r\n\r\n.kb-ctrl-back {\r\n  border-color: #ff475744;\r\n  color: #ff4757;\r\n  background: #ff47570d;\r\n}\r\n.kb-ctrl-back:hover, .kb-ctrl-back:active {\r\n  background: #ff475722;\r\n  border-color: #ff4757;\r\n}\r\n\r\n.kb-ctrl-send {\r\n  background: linear-gradient(135deg, #00b4cc, #00e5ff);\r\n  border-color: #00e5ff;\r\n  color: #0d1117;\r\n  font-weight: 900;\r\n}\r\n.kb-ctrl-send:hover, .kb-ctrl-send:active {\r\n  box-shadow: 0 4px 15px #00e5ff44;\r\n}\r\n</style>\r\n"],"mappings":"AAiIA;EACAA,IAAA;EACAC,KAAA;IACAC,KAAA;MAAAC,IAAA,EAAAC,MAAA;MAAA;IAAA;IACAC,OAAA;MAAAF,IAAA,EAAAG,OAAA;MAAA;IAAA;EACA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA;MAEAC,QAAA,GACA,2BACA,8BACA,0BACA;MAEAC,OAAA,GACA;QAAAC,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,EACA;MAEAC,QAAA,GACA;QAAAH,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA,GACA;QAAAF,KAAA;QAAAC,IAAA;QAAAC,GAAA;MAAA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}