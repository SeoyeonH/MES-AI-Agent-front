mit('send', {\n        text: text,\n        isVoice: this.lastWasVoice\n      });\n      this.inputText = '';\n      this.lastWasVoice = false;\n      this.$nextTick(function () {\n        if (_this2.$refs.textInput) _this2.$refs.textInput.focus();\n      });\n    },\n    selectHint: function selectHint(hint) {\n      var _this3 = this;\n      this.inputText = hint;\n      this.lastWasVoice = false;\n      this.$nextTick(function () {\n        _this3.sendMessage();\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","emits","data","inputText","isRecording","speechAvailable","recognition","lastWasVoice","hints","mounted","_this","SpeechRecognition","window","webkitSpeechRecognition","lang","continuous","interimResults","onresult","event","transcript","results","$nextTick","sendMessage","onerror","console","warn","error","onend","methods","startRecording","start","e","stopRecording","stop","_this2","text","trim","$emit","isVoice","$refs","textInput","focus","selectHint","hint","_this3"],"sources":["src/components/InputArea.vue"],"sourcesContent":["<template>\r\n  <div class=\"input-area\">\r\n\r\n    <!-- Quick hint chips -->\r\n    <div class=\"hint-chips\">\r\n      <button\r\n        v-for=\"hint in hints\"\r\n        :key=\"hint\"\r\n        class=\"hint-chip\"\r\n        @click=\"selectHint(hint)\"\r\n      >{{ hint }}</button>\r\n    </div>\r\n\r\n    <!-- Main input row -->\r\n    <div class=\"input-row\">\r\n\r\n      <!-- Mic Button -->\r\n      <button\r\n        class=\"mic-btn\"\r\n        :class=\"{ recording: isRecording, 'mic-unavailable': !speechAvailable }\"\r\n        @mousedown=\"startRecording\"\r\n        @mouseup=\"stopRecording\"\r\n        @mouseleave=\"stopRecording\"\r\n        @touchstart.prevent=\"startRecording\"\r\n        @touchend.prevent=\"stopRecording\"\r\n        :title=\"speechAvailable ? '누르는 동안 음성인식' : '이 브라우저는 음성인식을 지원하지 않습니다'\"\r\n      >\r\n        <span class=\"material-icons mic-icon\">{{ isRecording ? 'mic' : 'mic_none' }}</span>\r\n        <div v-if=\"isRecording\" class=\"pulse-ring\"></div>\r\n        <div v-if=\"isRecording\" class=\"pulse-ring pulse-ring-2\"></div>\r\n      </button>\r\n\r\n      <!-- Text Input -->\r\n      <div class=\"input-wrapper\">\r\n        <input\r\n          ref=\"textInput\"\r\n          v-model=\"inputText\"\r\n          class=\"text-input\"\r\n          :placeholder=\"isRecording ? '🎤 음성 인식 중...' : '명령을 입력하거나 🎤 마이크를 누르세요...'\"\r\n          @keydown.enter=\"sendMessage\"\r\n          :disabled=\"isRecording\"\r\n        />\r\n        <div v-if=\"isRecording\" class=\"recording-indicator\">\r\n          <span class=\"rec-dot\"></span>\r\n          REC\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Send Button -->\r\n      <button\r\n        class=\"send-btn\"\r\n        @click=\"sendMessage\"\r\n        :disabled=\"!inputText.trim() && !isRecording\"\r\n      >\r\n        <span class=\"material-icons\">send</span>\r\n        <span class=\"send-label\">SEND</span>\r\n      </button>\r\n\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'InputArea',\r\n  emits: ['send'],\r\n  data() {\r\n    return {\r\n      inputText: '',\r\n      isRecording: false,\r\n      speechAvailable: false,\r\n      recognition: null,\r\n      lastWasVoice: false,\r\n      hints: ['작업지시 조회', '실적 입력', '현황 보기', '작업 추가', '불량 조회']\r\n    }\r\n  },\r\n  mounted() {\r\n    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition\r\n    if (SpeechRecognition) {\r\n      this.speechAvailable = true\r\n      this.recognition = new SpeechRecognition()\r\n      this.recognition.lang = 'ko-KR'\r\n      this.recognition.continuous = false\r\n      this.recognition.interimResults = false\r\n\r\n      this.recognition.onresult = (event) => {\r\n        const transcript = event.results[0][0].transcript\r\n        this.inputText = transcript\r\n        this.lastWasVoice = true\r\n        this.$nextTick(() => {\r\n          this.sendMessage()\r\n        })\r\n      }\r\n\r\n      this.recognition.onerror = (event) => {\r\n        console.warn('음성인식 오류:', event.error)\r\n        this.isRecording = false\r\n      }\r\n\r\n      this.recognition.onend = () => {\r\n        this.isRecording = false\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    startRecording() {\r\n      if (!this.speechAvailable || this.isRecording) return\r\n      this.isRecording = true\r\n      this.inputText = ''\r\n      this.lastWasVoice = true\r\n      try {\r\n        this.recognition.start()\r\n      } catch (e) {\r\n        this.isRecording = false\r\n      }\r\n    },\r\n\r\n    stopRecording() {\r\n      if (!this.isRecording) return\r\n      try {\r\n        this.recognition.stop()\r\n      } catch (e) { /* ignore */ }\r\n      this.isRecording = false\r\n    },\r\n\r\n    sendMessage() {\r\n      const text = this.inputText.trim()\r\n      if (!text) return\r\n      this.$emit('send', { text, isVoice: this.lastWasVoice })\r\n      this.inputText = ''\r\n      this.lastWasVoice = false\r\n      this.$nextTick(() => {\r\n        if (this.$refs.textInput) this.$refs.textInput.focus()\r\n      })\r\n    },\r\n\r\n    selectHint(hint) {\r\n      this.inputText = hint\r\n      this.lastWasVoice = false\r\n      this.$nextTick(() => {\r\n        this.sendMessage()\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.input-area {\r\n  background: #161b22;\r\n  border-top: 1px solid #21262d;\r\n  padding: 10px 16px 12px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* === HINT CHIPS === */\r\n.hint-chips {\r\n  display: flex;\r\n  gap: 8px;\r\n  margin-bottom: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hint-chip {\r\n  background: transparent;\r\n  border: 1px solid #30363d;\r\n  border-radius: 20px;\r\n  color: #8b949e;\r\n  font-size: 12px;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  padding: 5px 14px;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n  font-weight: 500;\r\n}\r\n.hint-chip:hover {\r\n  border-color: #00e5ff;\r\n  color: #00e5ff;\r\n  background: #00e5ff11;\r\n}\r\n\r\n/* === INPUT ROW === */\r\n.input-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n/* === MIC BUTTON === */\r\n.mic-btn {\r\n  position: relative;\r\n  width: 56px;\r\n  height: 56px;\r\n  border-radius: 50%;\r\n  border: 2px solid #30363d;\r\n  background: #1c2333;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: all 0.2s;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.mic-btn:hover:not(.recording):not(.mic-unavailable) {\r\n  border-color: #00e5ff;\r\n  background: #00e5ff11;\r\n}\r\n\r\n.mic-btn.recording {\r\n  background: #ff1a2e;\r\n  border-color: #ff1a2e;\r\n  box-shadow: 0 0 20px #ff1a2e66;\r\n}\r\n\r\n.mic-btn.mic-unavailable {\r\n  opacity: 0.4;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.mic-icon {\r\n  font-size: 26px;\r\n  color: #c9d1d9;\r\n  z-index: 1;\r\n  position: relative;\r\n}\r\n.recording .mic-icon { color: #fff; }\r\n\r\n/* Pulse animation for recording */\r\n.pulse-ring {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform: translate(-50%, -50%);\r\n  border-radius: 50%;\r\n  border: 2px solid #ff1a2e;\r\n  animation: mic-pulse 1.5s infinite ease-out;\r\n  pointer-events: none;\r\n}\r\n.pulse-ring-2 {\r\n  animation-delay: 0.5s;\r\n}\r\n@keyframes mic-pulse {\r\n  0%   { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }\r\n  100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }\r\n}\r\n\r\n/* === TEXT INPUT === */\r\n.input-wrapper {\r\n  flex: 1;\r\n  position: relative;\r\n}\r\n\r\n.text-input {\r\n  width: 100%;\r\n  background: #0d1117;\r\n  border: 1px solid #30363d;\r\n  border-radius: 8px;\r\n  color: #c9d1d9;\r\n  font-size: 15px;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  padding: 14px 16px;\r\n  outline: none;\r\n  transition: border-color 0.2s;\r\n}\r\n.text-input::placeholder { color: #484f58; }\r\n.text-input:focus { border-color: #00e5ff; }\r\n.text-input:disabled { opacity: 0.6; }\r\n\r\n.recording-indicator {\r\n  position: absolute;\r\n  right: 12px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  color: #ff4757;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.rec-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  background: #ff4757;\r\n  border-radius: 50%;\r\n  animation: blink 1s infinite;\r\n}\r\n@keyframes blink {\r\n  0%, 100% { opacity: 1; }\r\n  50%       { opacity: 0; }\r\n}\r\n\r\n/* === SEND BUTTON === */\r\n.send-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 14px 22px;\r\n  background: linear-gradient(135deg, #00b4cc, #00e5ff);\r\n  border: none;\r\n  border-radius: 8px;\r\n  color: #0d1117;\r\n  font-size: 13px;\r\n  font-weight: 900;\r\n  font-family: 'Noto Sans KR', sans-serif;\r\n  letter-spacing: 1.5px;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n  flex-shrink: 0;\r\n}\r\n.send-btn:hover:not(:disabled) {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 4px 15px #00e5ff44;\r\n}\r\n.send-btn:active { transform: translateY(0); }\r\n.send-btn:disabled {\r\n  opacity: 0.4;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.send-btn .material-icons { font-size: 18px; }\r\n\r\n@media (max-width: 600px) {\r\n  .send-label { display: none; }\r\n}\r\n</style>\r\n"],"mappings":";AA+DA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,SAAA;MACAC,WAAA;MACAC,eAAA;MACAC,WAAA;MACAC,YAAA;MACAC,KAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACA,IAAAC,iBAAA,GAAAC,MAAA,CAAAD,iBAAA,IAAAC,MAAA,CAAAC,uBAAA;IACA,IAAAF,iBAAA;MACA,KAAAN,eAAA;MACA,KAAAC,WAAA,OAAAK,iBAAA;MACA,KAAAL,WAAA,CAAAQ,IAAA;MACA,KAAAR,WAAA,CAAAS,UAAA;MACA,KAAAT,WAAA,CAAAU,cAAA;MAEA,KAAAV,WAAA,CAAAW,QAAA,aAAAC,KAAA;QACA,IAAAC,UAAA,GAAAD,KAAA,CAAAE,OAAA,OAAAD,UAAA;QACAT,KAAA,CAAAP,SAAA,GAAAgB,UAAA;QACAT,KAAA,CAAAH,YAAA;QAC